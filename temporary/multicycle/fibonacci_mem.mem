// addi x10, x0, 0        # current byte address = 0
// addi x11, x0, 10       # number of Fibonacci elements
// addi x5,  x0, 0        # previous = 0
// addi x6,  x0, 1        # current  = 1
// 
// sw   x5, 0(x10)        # data_mem[0] = 0
// sw   x6, 4(x10)        # data_mem[1] = 1
// 
// addi x10, x10, 8       # byte address = 8
// addi x11, x11, -2      # 8 elements remain
// 
// fib_loop:
// beq  x11, x0, fib_done
// 
// add  x7, x5, x6
// sw   x7, 0(x10)
// 
// addi x10, x10, 4
// add  x5, x6, x0
// add  x6, x7, x0
// addi x11, x11, -1
// 
// beq  x0, x0, fib_loop
// 
// fib_done:
// beq  x0, x0, fib_done

// 0x00	addi x10, x0, 0	        00000513
// 0x04	addi x11, x0, 10	     00A00593
// 0x08	addi x5, x0, 0	         00000293
// 0x0C	addi x6, x0, 1	         00100313
// 0x10	sw x5, 0(x10)	          00552023
// 0x14	sw x6, 4(x10)	          00652223
// 0x18	addi x10, x10, 8	       00850513
// 0x1C	addi x11, x11, -2	      FFE58593
// 0x20	beq x11, x0, fib_done	  02058063
// 0x24	add x7, x5, x6	         006283B3
// 0x28	sw x7, 0(x10)	           00752023
// 0x2C	addi x10, x10, 4	    00450513
// 0x30	add x5, x6, x0	         000302B3
// 0x34	add x6, x7, x0	         00038333
// 0x38	addi x11, x11, -1	      FFF58593
// 0x3C	beq x0, x0, fib_loop	FE0002E3
// 0x40	beq x0, x0, fib_done	00000063

