// addi x10, x0, 0        # array base byte address
// addi x11, x0, 4        # 4 comparisons in first pass; array has 5 elements
// 
// sort_outer:
// beq  x11, x0, sort_done
// 
// add  x12, x10, x0      # current array pointer
// add  x13, x11, x0      # inner-loop count
// 
// sort_inner:
// beq  x13, x0, next_pass
// 
// lw   x5, 0(x12)        # x5 = array[j]
// lw   x6, 4(x12)        # x6 = array[j+1]
// 
// blt  x6, x5, swap      # swap when array[j+1] < array[j]
// 
// continue_inner:
// addi x12, x12, 4
// addi x13, x13, -1
// beq  x0, x0, sort_inner
// 
// swap:
// sw   x6, 0(x12)
// sw   x5, 4(x12)
// beq  x0, x0, continue_inner
// 
// next_pass:
// addi x11, x11, -1
// beq  x0, x0, sort_outer
// 
// sort_done:
// beq  x0, x0, sort_done












