//         addi  x10, x0, 0          # Array base byte address
//         jal   x1, init_array      # Call init_array
//                                   # x1 = return address 0x08
//         addi  x10, x0, 0          # Array base address
//         addi  x11, x0, 5          # Number of elements
//         auipc x5, 0               # x5 = current PC = 0x10
//         addi  x5, x5, 64          # x5 = 0x10 + 64 = 0x50
//         jalr  x1, 0(x5)           # Call sum_array indirectly
//                                   # x1 = 0x1C
//                                   # PC = x5 = 0x50
//         sw    x12, 20(x0)         # data_mem[5] = sum
// done:
//         jal   x0, done            # Infinite loop
// # ============================================================
// # Function: init_array
// #
// # Creates:
// # data_mem[0] = 7
// # data_mem[1] = 2
// # data_mem[2] = 9
// # data_mem[3] = 4
// # data_mem[4] = 6
// # ============================================================
// 
// init_array:
//         addi  x6, x0, 7
//         sw    x6, 0(x0)
//         addi  x6, x0, 2
//         sw    x6, 4(x0)
//         addi  x6, x0, 9
//         sw    x6, 8(x0)
//         addi  x6, x0, 4
//         sw    x6, 12(x0)
//         addi  x6, x0, 6
//         sw    x6, 16(x0)
//         jalr  x0, 0(x1)           # Return to main
// 
// sum_array:
//         addi  x12, x0, 0          # sum = 0
// sum_loop:
//         beq   x11, x0, sum_return
//         lw    x13, 0(x10)         # Load array element
//         add   x12, x12, x13       # Add element to sum
//         addi  x10, x10, 4         # Next array address
//         addi  x11, x11, -1        # Decrease count
//         jal   x0, sum_loop        # Jump without changing x1
// sum_return:
//         jalr  x0, 0(x1)           # Return to main
// 
// 
// 

// 0x00	addi x10, x0, 0	       00000513
// 0x04	jal x1, init_array	   020000EF
// 0x08	addi x10, x0, 0	       00000513
// 0x0C	addi x11, x0, 5	       00500593
// 0x10	auipc x5, 0	           00000297
// 0x14	addi x5, x5, 64	       04028293
// 0x18	jalr x1, 0(x5)	        000280E7
// 0x1C	sw x12, 20(x0)	        00C02A23
// 0x20	jal x0, done	        0000006F
// 0x24	addi x6, x0, 7	        00700313
// 0x28	sw x6, 0(x0)	        00602023
// 0x2C	addi x6, x0, 2	        00200313
// 0x30	sw x6, 4(x0)	        00602223
// 0x34	addi x6, x0, 9	        00900313
// 0x38	sw x6, 8(x0)	        00602423
// 0x3C	addi x6, x0, 4	        00400313
// 0x40	sw x6, 12(x0)	        00602623
// 0x44	addi x6, x0, 6	        00600313
// 0x48	sw x6, 16(x0)	        00602823
// 0x4C	jalr x0, 0(x1)	        00008067
// 0x50	addi x12, x0, 0	        00000613
// 0x54	beq x11, x0, sum_return	00058C63
// 0x58	lw x13, 0(x10)	        00052683
// 0x5C	add x12, x12, x13	     00D60633
// 0x60	addi x10, x10, 4	     00450513
// 0x64	addi x11, x11, -1	     FFF58593
// 0x68	jal x0, sum_loop	     FEDFF06F
// 0x6C	jalr x0, 0(x1)	         00008067
