// addi x10, x0, 0       # x10 = array byte address
// addi x11, x0, 5       # x11 = number of elements
// lui  x5, 0x12345      # x5 = 0x12345000
// sw   x5, 24(x0)       # data_mem[6] = 0x12345000

// auipc x6, 0            # x6 = address of this AUIPC instruction
// sw    x6, 28(x0)       # data_mem[7] = recorded code address
 
// jal  x1, sum_array     # x1 = return address; PC = sum_array
 
// # Execution returns here
// sw   x12, 20(x0)       # data_mem[5] = calculated sum

// done:
// beq  x0, x0, done      # infinite loop

// sum_array:
// addi x12, x0, 0        # sum = 0
 
// sum_loop:
// beq  x11, x0, sum_return
// 
// lw   x13, 0(x10)       # load current array element
// add  x12, x12, x13     # sum = sum + element
// 
// addi x10, x10, 4       # move to next 32-bit word
// addi x11, x11, -1      # decrease remaining count
// 
// jal  x0, sum_loop      # unconditional jump; no return address

// sum_return:
// jalr x0, 0(x1)         # return to instruction after function call
 
