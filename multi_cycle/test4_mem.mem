// # ============================================================
// # Signed sensor-data and instruction self-test
// #
// # Data-memory results:
// #   data_mem[0] contains byte/halfword test data
// #   data_mem[1] contains -20 as a 32-bit word
// #   data_mem[2] contains:
// #       54  if tests pass
// #       -1  if a branch test fails
// # ============================================================
// 
//         addi  x10, x0, 0          # Data-memory base address
//         addi  x5,  x0, -20        # Signed test sample = -20
// 
//         sb    x5, 0(x10)          # Store low byte: 0xEC
//         sh    x5, 2(x10)          # Store halfword: 0xFFEC
//         sw    x5, 4(x10)          # Store word: 0xFFFFFFEC
// 
//         lb    x6, 0(x10)          # Signed byte:     x6 = -20
//         lbu   x7, 0(x10)          # Unsigned byte:   x7 = 236
//         lh    x8, 2(x10)          # Signed halfword: x8 = -20
//         lhu   x9, 2(x10)          # Unsigned half:   x9 = 65516
//         lw    x11, 4(x10)         # Signed word:     x11 = -20
// 
//         slti  x12, x6, 0          # -20 < 0 signed: x12 = 1
//         sltiu x13, x6, 1          # unsigned(-20) < 1: x13 = 0
// 
//         slli  x14, x12, 3         # 1 << 3 = 8
//         srli  x15, x7, 2          # 236 >> 2 = 59
//         srai  x16, x6, 2          # -20 >>> 2 = -5
// 
//         xori  x17, x7, 255        # 236 XOR 255 = 19
//         ori   x18, x14, 2         # 8 OR 2 = 10
//         andi  x19, x7, 15         # 236 AND 15 = 12
// 
//         add   x20, x15, x16       # 59 + (-5) = 54
//         slt   x21, x6, x7         # signed: -20 < 236 → 1
//         sltu  x22, x6, x7         # unsigned: -20 < 236 → 0
// 
//         # Validation branches.
//         # Any unexpected result jumps to fail.
// 
//         bne   x6, x8, fail        # Expected: not taken
//         blt   x7, x6, fail        # 236 < -20 signed? No
//         bltu  x6, x7, fail        # unsigned(-20) < 236? No
//         bgeu  x7, x6, fail        # 236 >= unsigned(-20)? No
// 
//         beq   x6, x8, pass        # Expected: taken
// 
// fail:
//         addi  x20, x0, -1         # Failure result
// 
// pass:
//         auipc x24, 0              # x24 = current PC = 0x6C
//         jal   x1, save_result     # x1 = 0x74; jump to 0x78
// 
// done:
//         jal   x0, done            # Infinite loop
// 
// save_result:
//         sw    x20, 8(x10)         # data_mem[2] = 54 or -1
//         jalr  x0, 0(x1)           # Return to address 0x74
// 
// 
// 
// 













