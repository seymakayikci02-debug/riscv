// xori  x1,  x0, 16          x1  = 16        # data-memory base address
//
// addi  x2,  x0, 25          x2  = 25        # temperature = 25 C
// ori   x3,  x0, 1200        x3  = 1200      # pressure = 1200
// lui   x4,  0x12345         x4  = 0x12345000
//
// sb    x2,  0(x1)           mem[16]    = 25
// sh    x3,  2(x1)           mem[18:19] = 1200
// sw    x4,  4(x1)           mem[20:23] = 0x12345000
//
// lb    x5,  0(x1)           x5  = 25
// lbu   x6,  0(x1)           x6  = 25
// lh    x7,  2(x1)           x7  = 1200
// lhu   x8,  2(x1)           x8  = 1200
// lw    x9,  4(x1)           x9  = 0x12345000
//
// slti  x10, x5, 30          x10 = 1         # 25 < 30
// sltiu x11, x8, 1500        x11 = 1         # 1200 < 1500
//
// andi  x12, x6, 15          x12 = 9         # 25 & 15
//
// slli  x13, x5, 1           x13 = 50        # 25 << 1
// srli  x14, x9, 12          x14 = 0x00012345
// srai  x15, x7, 1           x15 = 600       # 1200 >> 1
//
// add   x16, x13, x15        x16 = 650       # 50 + 600
// sub   x17, x16, x5         x17 = 625       # 650 - 25
//
// sll   x18, x10, x11        x18 = 2         # 1 << 1
//
// slt   x19, x5, x7          x19 = 1         # 25 < 1200
// sltu  x20, x14, x9         x20 = 1
//
// xor   x21, x14, x12        x21 = 0x0001234C
// srl   x22, x21, x11        x22 = 0x000091A6
// sra   x23, x17, x11        x23 = 312
//
// or    x24, x18, x19        x24 = 3         # 2 | 1
// and   x25, x21, x14        x25 = 0x00012344
//
// sw    x24, 8(x1)           mem[24:27] = 3
//
// auipc x26, 0               x26 = 116       # PC = 116 = 0x74
// jalr  x27, 8(x26)          x27 = 124       # return address = 0x7C
// jal   x28, 4               x28 = 128       # return address = 0x80
//
//
//
// FINAL REGISTER VALUES
//
// x0  = 0
// x1  = 16
// x2  = 25
// x3  = 1200
// x4  = 0x12345000
// x5  = 25
// x6  = 25
// x7  = 1200
// x8  = 1200
// x9  = 0x12345000
// x10 = 1
// x11 = 1
// x12 = 9
// x13 = 50
// x14 = 0x00012345
// x15 = 600
// x16 = 650
// x17 = 625
// x18 = 2
// x19 = 1
// x20 = 1
// x21 = 0x0001234C
// x22 = 0x000091A6
// x23 = 312
// x24 = 3
// x25 = 0x00012344
// x26 = 116
// x27 = 124
// x28 = 128
// x29 = 0
// x30 = 0
// x31 = 0
//
//
//
// FINAL DATA MEMORY VALUES
// assuming data memory starts initialized to 0
//
// byte addresses:
//
// mem[16] = 0x19
// mem[17] = 0x00
// mem[18] = 0xB0
// mem[19] = 0x04
//
// mem[20] = 0x00
// mem[21] = 0x50
// mem[22] = 0x34
// mem[23] = 0x12
//
// mem[24] = 0x03
// mem[25] = 0x00
// mem[26] = 0x00
// mem[27] = 0x00
//
//
// If data_mem is a 32-bit word array:
//
// data_mem[4] = 0x04B00019
// data_mem[5] = 0x12345000
// data_mem[6] = 0x00000003
//
// All other data_mem words remain 0.


















