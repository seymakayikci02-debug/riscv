// xori  x1,  x0, 64          x1  = 64
// addi  x2,  x0, 25          x2  = 25              // temperature
// ori   x3,  x0, 1200        x3  = 1200            // pressure
// lui   x4,  0x12345         x4  = 0x12345000      // device ID
//
// sb    x2,  0(x1)           mem[64]    = 25
// sh    x3,  2(x1)           mem[66:67] = 1200
// sw    x4,  4(x1)           mem[68:71] = 0x12345000
//
// lb    x5,  0(x1)           x5  = 25
// lbu   x6,  0(x1)           x6  = 25
// lh    x7,  2(x1)           x7  = 1200
// lhu   x8,  2(x1)           x8  = 1200
// lw    x9,  4(x1)           x9  = 0x12345000
//
// slti  x10, x5, 30          x10 = 1              // 25 < 30
// sltiu x11, x8, 1500        x11 = 1              // 1200 < 1500
// andi  x12, x6, 15          x12 = 9              // 25 & 15 = 9
//
// slli  x13, x5, 1           x13 = 50             // 25 << 1
// srli  x14, x9, 12          x14 = 0x00012345
// srai  x15, x7, 1           x15 = 600            // 1200 >> 1
//
// add   x16, x13, x15        x16 = 650            // 50 + 600
// sub   x17, x16, x5         x17 = 625            // 650 - 25
//
// sll   x18, x10, x11        x18 = 2              // 1 << 1
// slt   x19, x5, x7          x19 = 1              // 25 < 1200
// sltu  x20, x14, x9         x20 = 1
//
// xor   x21, x14, x12        x21 = 0x0001234C
// srl   x22, x21, x11        x22 = 0x000091A6
// sra   x23, x17, x11        x23 = 312            // 625 >> 1
//
// or    x24, x18, x19        x24 = 3              // 2 | 1
// and   x25, x21, x14        x25 = 0x00012344
//
// sw    x24, 8(x1)           mem[72:75] = 3       // final status
//
// auipc x26, 0               x26 = 116            // current PC
// jalr  x27, 8(x26)          x27 = 124            // return address
// jal   x28, 4               x28 = 128            // return address

// data_mem[16] = 32'h04B00019    // address 64: temperature + pressure
// data_mem[17] = 32'h12345000    // address 68: device ID
// data_mem[18] = 32'h00000003    // address 72: final status





