// // main:
//      00000513   addi  x10, x0, 0            # Data-memory base address
//      01C000EF   jal   x1, process_packet    # Call processing function
//      01452423   sw    x20, 8(x10)           # Store diagnostic result
//      01051623   sh    x16, 12(x10)          # Store scaled current
//      01550723   sb    x21, 14(x10)          # Store alarm flag
//      00000C17   auipc x24, 0                # Record current program address
//      01852823   sw    x24, 16(x10)
// // done:
//      0000006F   jal   x0, done              # Infinite loop
// 
// 
// // # ============================================================
// // # Process battery sensor packet
// // # ============================================================
// 
// // process_packet:
//      00050583   lb    x11, 0(x10)           # Signed temperature
//      00154603   lbu   x12, 1(x10)           # Unsigned status byte
//      00251683   lh    x13, 2(x10)           # Signed current
//      00255703   lhu   x14, 2(x10)           # Raw unsigned current representation
//      00452783   lw    x15, 4(x10)           # Battery voltage
// 
//      4026D813   srai  x16, x13, 2           # Scaled current = -300 / 4 = -75
// 
//      00165893   srli  x17, x12, 1
//      00189893   slli  x17, x17, 1           # Clear lowest status bit
// 
//      00F67913   andi  x18, x12, 15          # Extract lower four status bits
//      00594993   xori  x19, x18, 5
//      0119C9B3   xor   x19, x19, x17         # Generate status signature
// 
//      01078A33   add   x20, x15, x16         # Voltage + scaled current
//      413A0A33   sub   x20, x20, x19         # Diagnostic calculation
// 
//      00C97933   and   x18, x18, x12         # Retain active status bits
// 
//      FF65AA93   slti  x21, x11, -10         # Alarm if temperature < -10 °C
//      08063B13   sltiu x22, x12, 128         # Is status byte below 128?
// 
//      000A9863   bne   x21, x0, alarm        # Cold temperature → alarm
//      000B0663   beq   x22, x0, alarm        # Status bit 7 set → alarm
// 
// // normal:
//      001A6A13   ori   x20, x20, 1           # Mark normal result
//      00008067   jalr  x0, 0(x1)             # Return to main
// 
// // alarm:
//      BAD00BB7   lui   x23, 0xBAD00          # x23 = 0xBAD00000
//      017A6A33   or    x20, x20, x23         # Add alarm signature
//      00100A93   addi  x21, x0, 1            # Alarm flag = 1
//      00008067   jalr  x0, 0(x1)             # Return to main
//      
// 
// 















// # ============================================================
// # Battery-pack safety monitor
// #
// # Input packet:
// #   byte  0: signed temperature = -20
// #   byte  1: unsigned status    = 0xA5
// #   half  2: signed current     = -300
// #   word  4: voltage            = 28000
// #
// # Outputs:
// #   word  8: diagnostic result
// #   half 12: scaled current
// #   byte 14: alarm flag
// #   word 16: program-location record
// # ============================================================
// 
// main:
//         addi  x10, x0, 0           # Data-memory base address
// 
//         jal   x1, process_packet    # Call processing function
// 
//         sw    x20, 8(x10)           # Store diagnostic result
//         sh    x16, 12(x10)          # Store scaled current
//         sb    x21, 14(x10)          # Store alarm flag
// 
//         auipc x24, 0                # Record current program address
//         sw    x24, 16(x10)
// 
// done:
//         jal   x0, done              # Infinite loop
// 
// 
// # ============================================================
// # Process battery sensor packet
// # ============================================================
// 
// process_packet:
//         lb    x11, 0(x10)           # Signed temperature
//         lbu   x12, 1(x10)           # Unsigned status byte
//         lh    x13, 2(x10)           # Signed current
//         lhu   x14, 2(x10)           # Raw unsigned current representation
//         lw    x15, 4(x10)           # Battery voltage
// 
//         srai  x16, x13, 2           # Scaled current = -300 / 4 = -75
// 
//         srli  x17, x12, 1
//         slli  x17, x17, 1           # Clear lowest status bit
// 
//         andi  x18, x12, 15          # Extract lower four status bits
//         xori  x19, x18, 5
//         xor   x19, x19, x17         # Generate status signature
// 
//         add   x20, x15, x16         # Voltage + scaled current
//         sub   x20, x20, x19         # Diagnostic calculation
// 
//         and   x18, x18, x12         # Retain active status bits
// 
//         slti  x21, x11, -10         # Alarm if temperature < -10 °C
//         sltiu x22, x12, 128         # Is status byte below 128?
// 
//         bne   x21, x0, alarm         # Cold temperature → alarm
//         beq   x22, x0, alarm         # Status bit 7 set → alarm
// 
// normal:
//         ori   x20, x20, 1           # Mark normal result
//         jalr  x0, 0(x1)             # Return to main
// 
// alarm:
//         lui   x23, 0xBAD00           # x23 = 0xBAD00000
//         or    x20, x20, x23         # Add alarm signature
//         addi  x21, x0, 1            # Alarm flag = 1
//         jalr  x0, 0(x1)             # Return to main

//  data_mem[0]	FED4A5EC	Original sensor packet
//  data_mem[1]	00006D60	Voltage: 28000
//  data_mem[2]	BAD06C71	Alarm diagnostic result
//  data_mem[3]	0001FFB5	Alarm flag and scaled current
//  data_mem[4]	00000014	Address of the AUIPC instruction

// x0  (zero) = 00000000
// x1  (ra)   = 00000008
// x2  (sp)   = 00000000
// x3  (gp)   = 00000000
// x4  (tp)   = 00000000
// x5  (t0)   = 00000000
// x6  (t1)   = 00000000
// x7  (t2)   = 00000000
// x8  (s0)   = 00000000
// x9  (s1)   = 00000000
// x10 (a0)   = 00000000
// x11 (a1)   = FFFFFFEC    # temperature = -20
// x12 (a2)   = 000000A5    # status = 165
// x13 (a3)   = FFFFFED4    # signed current = -300
// x14 (a4)   = 0000FED4    # unsigned halfword = 65236
// x15 (a5)   = 00006D60    # voltage = 28000
// x16 (a6)   = FFFFFFB5    # scaled current = -75
// x17 (a7)   = 000000A4    # status with lowest bit cleared
// x18 (s2)   = 00000005    # active status bits retained
// x19 (s3)   = 000000A4    # status signature
// x20 (s4)   = BAD06C71    # alarm diagnostic result
// x21 (s5)   = 00000001    # alarm flag = 1
// x22 (s6)   = 00000000    # status byte < 128 check result (false)
// x23 (s7)   = BAD00000    # alarm signature base (lui)
// x24 (s8)   = 00000014    # address of the AUIPC instruction
// x25 (s9)   = 00000000
// x26 (s10)  = 00000000
// x27 (s11)  = 00000000
// x28 (t3)   = 00000000
// x29 (t4)   = 00000000
// x30 (t5)   = 00000000
// x31 (t6)   = 00000000
// 









